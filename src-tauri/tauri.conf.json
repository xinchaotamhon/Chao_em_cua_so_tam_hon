{
  "$schema": "https://schema.tauri.app/config/2.0.6",
  "productName": "Chào em cửa sổ tâm hồn",
  "mainBinaryName": "chao-em-cua-so-tam-hon",
  "version": "2.1.3",
  "identifier": "vn.xinchaotamhon.chaoem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chào em cửa sổ tâm hồn",
        "width": 1000,
        "height": 640,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/media/**"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Nguyễn Ái Dân",
    "category": "Productivity",
    "shortDescription": "Nhắc nghỉ mắt theo quy tắc 20-20-20.",
    "longDescription": "Nhắc bạn rời mắt khỏi màn hình theo quy tắc 20-20-20: cứ 20 phút, nhìn ra xa 6 mét trong 20 giây. Chạy dưới khay hệ thống, phủ kín màn hình khi tới giờ nghỉ, có thể tự khởi động cùng máy.",
    "publisher": "Nguyễn Ái Dân",
    "license": "MIT",
    "licenseFile": "LICENSE.txt",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": { "files": {} },
      "rpm": { "epoch": 0, "files": {}, "release": "1" }
    },
    "macOS": {
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
